{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{TOKEN_DIET}}/scripts/session_guard.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{TOKEN_DIET}}/scripts/session_guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{TOKEN_DIET}}/scripts/session_guard.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
